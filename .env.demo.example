# Plantilla del entorno de la demo pública (demo-deployment).
# Copia este archivo a .env.demo (ignorado por git) y rellénalo. Lo cargan solo
# los comandos `npm run demo:*` a través de scripts/with-demo-env.sh; nunca se
# usa .env. Guía completa: docs/operacion-demo.md.
#
# No commitear nunca .env.demo ni pegar estos valores en el repositorio.

# Neon (región UE). Ambas URLs con sslmode=require.
# Pooler (host con -pooler): la usa la app en runtime (también en Vercel).
DATABASE_URL=""
# Conexión directa (sin -pooler): migraciones (`demo:status`, `demo:migrate`) y seed.
DATABASE_URL_UNPOOLED=""

# Contraseñas de los usuarios de presentación: obligatorias, al menos 12
# caracteres, aleatorias (p. ej. `openssl rand -base64 18`) y distintas de las
# de ejemplo de .env.example. Nunca se configuran en Vercel.
SEED_ADMIN_PASSWORD=""
SEED_SUPERADMIN_PASSWORD=""
# Oficina, técnico y encargado (ADMINISTRADOR+TECNICO) comparten esta.
SEED_EQUIPO_PASSWORD=""
# Usuario de cliente con acceso al portal.
SEED_CLIENTE_PASSWORD=""

# Emails opcionales (por defecto los de abajo). Descomentar solo si se cambian.
# SEED_ADMIN_EMAIL="admin@demo.local"
# SEED_SUPERADMIN_EMAIL="superadmin@demo.local"
# SEED_OFICINA_EMAIL="oficina@demo.local"
# SEED_TECNICO_EMAIL="tecnico@demo.local"
# SEED_ENCARGADO_EMAIL="encargado@demo.local"
# SEED_CLIENTE_EMAIL="cliente@demo.local"
