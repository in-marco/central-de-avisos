// Esquema base multiempresa. Las tablas usan snake_case y los modelos
// Prisma PascalCase/camelCase, mapeados con @@map/@map.
//
// La URL de conexión se configura en prisma.config.ts (Prisma 7 no la lee
// del bloque datasource ni carga .env automáticamente).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EstadoEmpresa {
  ACTIVA
  SUSPENDIDA

  @@map("estado_empresa")
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO

  @@map("estado_usuario")
}

// Roles de empresa combinables. Los permisos se derivan en código
// (src/lib/authz/permissions.ts). El superadmin nunca tiene roles (CHECK).
enum RolUsuario {
  ADMINISTRADOR
  OFICINA
  TECNICO

  @@map("rol_usuario")
}

// ADMINISTRADOR_EMPRESA: alta de empresa por el proveedor (destino /panel).
// CONTACTO_CLIENTE: acceso al portal de un contacto de cliente (destino /portal).
enum TipoInvitacion {
  ADMINISTRADOR_EMPRESA
  CONTACTO_CLIENTE

  @@map("tipo_invitacion")
}

// Modo fiscal de la empresa. El MVP solo admite NO_VERIFACTU; añadir
// VERIFACTU exige una feature/ADR con ALTER TYPE ... ADD VALUE.
enum ModoFiscal {
  NO_VERIFACTU

  @@map("modo_fiscal")
}

// Prioridad de un aviso. El chip de la interfaz la muestra con icono y texto.
enum PrioridadAviso {
  NORMAL
  ALTA
  URGENTE

  @@map("prioridad_aviso")
}

// Origen de un aviso. El alta de oficina siempre escribe OFICINA; CLIENTE
// llegará con el portal de cliente.
enum OrigenAviso {
  OFICINA
  CLIENTE

  @@map("origen_aviso")
}

// Ciclo de vida completo del aviso. office-aviso-creation solo escribe NUEVO;
// las transiciones pertenecen a features posteriores.
enum EstadoAviso {
  NUEVO
  PENDIENTE
  ASIGNADO
  EN_CURSO
  RESUELTO
  FACTURADO
  CANCELADO

  @@map("estado_aviso")
}

model Plan {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String   @unique
  importeMensual Decimal  @map("importe_mensual") @db.Decimal(12, 2)
  activo         Boolean  @default(true)
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  empresas Empresa[]

  @@map("planes")
}

model Empresa {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String
  nif              String        @unique
  direccionFiscal  String?       @map("direccion_fiscal")
  emailFacturacion String        @map("email_facturacion")
  planId           String        @map("plan_id") @db.Uuid
  estado           EstadoEmpresa @default(ACTIVA)
  // Configuración de facturación. NULL = sin configurar (CHECK de formato de
  // serie y de tarifa positiva en la migración empresa_facturacion).
  serieFactura     String?       @map("serie_factura")
  tarifaHoraria    Decimal?      @map("tarifa_horaria") @db.Decimal(10, 2)
  modoFiscal       ModoFiscal    @default(NO_VERIFACTU) @map("modo_fiscal")
  creadoEn         DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usuarios     Usuario[]
  invitaciones Invitacion[]
  clientes     Cliente[]
  avisos       Aviso[]

  @@index([planId])
  @@map("empresas")
}

model Usuario {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String?       @map("empresa_id") @db.Uuid
  email         String        @unique
  nombre        String
  passwordHash  String?       @map("password_hash")
  estado        EstadoUsuario @default(ACTIVO)
  esSuperadmin  Boolean       @default(false) @map("es_superadmin")
  roles         RolUsuario[]  @default([])
  // Usuario de cliente (portal): `cliente_id` no nulo, sin roles, no
  // superadmin y con empresa (CHECK usuarios_cliente_coherente). El FK
  // compuesto impide un cliente de otra empresa. `contacto_id` (único) liga
  // el acceso a un contacto; la regla «el contacto es de ese cliente» se
  // aplica en src/lib/portal/invitaciones.ts (FK simple, como contactos.sede_id).
  clienteId     String?       @map("cliente_id") @db.Uuid
  contactoId    String?       @unique @map("contacto_id") @db.Uuid
  creadoEn      DateTime      @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime      @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  empresa          Empresa?     @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cliente          Cliente?     @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  contacto         Contacto?    @relation(fields: [contactoId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sesiones         Sesion[]
  invitaciones     Invitacion[]
  avisosCreados    Aviso[]      @relation("AvisoCreadoPor")
  avisosValidados  Aviso[]      @relation("AvisoValidadoPor")
  avisosCancelados Aviso[]      @relation("AvisoCanceladoPor")

  @@index([empresaId])
  @@index([clienteId])
  @@map("usuarios")
}

// Sesión opaca y revocable. El token crudo nunca se guarda: solo su SHA-256.
model Sesion {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  creadaEn   DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  expiraEn   DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadaEn DateTime? @map("revocada_en") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([usuarioId])
  @@index([expiraEn])
  @@map("sesiones")
}

// Invitación para activar a un usuario. El token crudo nunca se guarda: solo
// su SHA-256. La caducidad y el estado derivado se calculan en aplicación.
model Invitacion {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId  String         @map("empresa_id") @db.Uuid
  usuarioId  String         @map("usuario_id") @db.Uuid
  tipo       TipoInvitacion @default(ADMINISTRADOR_EMPRESA)
  tokenHash  String         @unique @map("token_hash")
  creadaEn   DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)
  expiraEn   DateTime       @map("expira_en") @db.Timestamptz(3)
  aceptadaEn DateTime?      @map("aceptada_en") @db.Timestamptz(3)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([empresaId])
  @@index([usuarioId])
  @@index([expiraEn])
  @@map("invitaciones")
}

// Cliente de una empresa de servicios. Es el sujeto fiscal: razón social, NIF
// y dirección de facturación viven solo aquí (la factura futura referenciará
// `cliente_id`, nunca la sede). `tarifa_horaria` es opcional y sustituye a la
// tarifa de la empresa. CHECK de NIF normalizado y tarifa no negativa en SQL.
model Cliente {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId            String   @map("empresa_id") @db.Uuid
  razonSocial          String   @map("razon_social")
  nif                  String
  direccionFacturacion String   @map("direccion_facturacion")
  tarifaHoraria        Decimal? @map("tarifa_horaria") @db.Decimal(12, 2)
  creadoEn             DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn        DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sedes     Sede[]
  contactos Contacto[]
  avisos    Aviso[]
  usuarios  Usuario[]

  // Destino de los FK compuestos (cliente_id, empresa_id) de sedes, contactos
  // y usuarios de cliente.
  @@unique([id, empresaId])
  @@unique([empresaId, nif])
  @@map("clientes")
}

// Sede de un cliente: solo el lugar de la intervención, sin datos fiscales.
// El FK compuesto impide que la sede tenga una empresa distinta de su cliente.
model Sede {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  nombre        String
  direccion     String
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  cliente   Cliente    @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  contactos Contacto[]
  avisos    Aviso[]

  @@unique([id, clienteId])
  @@index([clienteId])
  @@map("sedes")
}

// Contacto de un cliente, opcionalmente vinculado a una de sus sedes. Prisma
// no permite una relación opcional que reutilice `cliente_id` (obligatorio),
// así que `sede_id` es un FK simple y la regla «la sede es del mismo cliente»
// se aplica en src/lib/clientes/clientes.ts. Los CHECK de teléfono o email y
// de email normalizado viven en SQL.
model Contacto {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  clienteId     String   @map("cliente_id") @db.Uuid
  sedeId        String?  @map("sede_id") @db.Uuid
  nombre        String
  telefono      String?
  email         String?
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  cliente Cliente  @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  sede    Sede?    @relation(fields: [sedeId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  avisos  Aviso[]
  // Acceso al portal de este contacto (como mucho uno).
  usuario Usuario?

  // Destino del FK compuesto (contacto_id, cliente_id) de avisos.
  @@unique([id, clienteId])
  @@index([clienteId])
  @@index([sedeId])
  @@map("contactos")
}

// Aviso: solicitud de intervención de un cliente en una de sus sedes. Los FK
// compuestos impiden en PostgreSQL mezclar empresa, cliente, sede y contacto:
// (cliente_id, empresa_id) → clientes, (sede_id, cliente_id) → sedes y
// (contacto_id, cliente_id) → contactos. Que el contacto sea de todo el
// cliente o de la sede elegida lo aplica src/lib/avisos/avisos.ts. El CHECK
// avisos_descripcion_no_vacia vive en SQL. `origen` y `estado` los fija el
// servidor; el alta de oficina escribe OFICINA y NUEVO.
model Aviso {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId         String         @map("empresa_id") @db.Uuid
  clienteId         String         @map("cliente_id") @db.Uuid
  sedeId            String         @map("sede_id") @db.Uuid
  contactoId        String         @map("contacto_id") @db.Uuid
  descripcion       String
  prioridad         PrioridadAviso @default(NORMAL)
  origen            OrigenAviso
  estado            EstadoAviso    @default(NUEVO)
  creadoPorId       String         @map("creado_por_id") @db.Uuid
  creadoEn          DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn     DateTime       @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  // Validación y cancelación (aviso-validation-pool). Las fija el servidor en
  // src/lib/avisos/avisos.ts con updateMany condicionado al estado de origen.
  // Su coherencia con `estado` la garantizan los CHECK
  // avisos_validacion_coherente, avisos_cancelacion_coherente y
  // avisos_motivo_cancelacion_no_vacio (migración SQL).
  validadoEn        DateTime?      @map("validado_en") @db.Timestamptz(3)
  validadoPorId     String?        @map("validado_por_id") @db.Uuid
  canceladoEn       DateTime?      @map("cancelado_en") @db.Timestamptz(3)
  canceladoPorId    String?        @map("cancelado_por_id") @db.Uuid
  motivoCancelacion String?        @map("motivo_cancelacion")

  empresa      Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cliente      Cliente  @relation(fields: [clienteId, empresaId], references: [id, empresaId], onDelete: Restrict, onUpdate: Restrict)
  sede         Sede     @relation(fields: [sedeId, clienteId], references: [id, clienteId], onDelete: Restrict, onUpdate: Restrict)
  contacto     Contacto @relation(fields: [contactoId, clienteId], references: [id, clienteId], onDelete: Restrict, onUpdate: Restrict)
  creadoPor    Usuario  @relation("AvisoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  validadoPor  Usuario? @relation("AvisoValidadoPor", fields: [validadoPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  canceladoPor Usuario? @relation("AvisoCanceladoPor", fields: [canceladoPorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([empresaId, creadoEn])
  @@index([empresaId, estado])
  @@index([clienteId])
  @@index([sedeId])
  @@index([contactoId])
  @@map("avisos")
}

// Límite de intentos de login (demo-deployment). Tabla técnica global sin
// empresa_id: la identidad precede al tenant, como `planes`. La clave es
// `email:<sha256>` o `ip:<sha256>`; nunca guarda el email ni la IP en claro.
// Los CHECK viven en la migración SQL y el tiempo se calcula en PostgreSQL
// (src/lib/auth/rate-limit.ts).
model LimiteLogin {
  clave         String   @id
  intentos      Int
  ventanaInicio DateTime @map("ventana_inicio") @db.Timestamptz(3)

  @@index([ventanaInicio])
  @@map("limites_login")
}
