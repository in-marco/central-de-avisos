# Copia este archivo a .env y ajusta la URL a tu PostgreSQL local.
# Las credenciales de ejemplo son solo para desarrollo local: no usar en producción.
DATABASE_URL="postgresql://central:central@localhost:5432/central_de_avisos?schema=public"

# Seed local de `npm run db:seed`. No usar estas contraseñas fuera de desarrollo.
SEED_ADMIN_EMAIL="admin@demo.local"
SEED_ADMIN_PASSWORD="demo-admin-local"
SEED_SUPERADMIN_EMAIL="superadmin@demo.local"
SEED_SUPERADMIN_PASSWORD="demo-superadmin-local"
