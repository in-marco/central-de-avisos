# Copia este archivo a .env y ajusta la URL a tu PostgreSQL local.
# Las credenciales de ejemplo son solo para desarrollo local: no usar en producción.
DATABASE_URL="postgresql://central:central@localhost:5432/central_de_avisos?schema=public"

# Seed local de `npm run db:seed`. No usar estas contraseñas fuera de desarrollo.
SEED_ADMIN_EMAIL="admin@demo.local"
SEED_ADMIN_PASSWORD="demo-admin-local"
SEED_SUPERADMIN_EMAIL="superadmin@demo.local"
SEED_SUPERADMIN_PASSWORD="demo-superadmin-local"
# Equipo demo de Empresa Demo (misma contraseña para los tres):
# oficina (OFICINA), técnico (TECNICO) y encargado (ADMINISTRADOR+TECNICO).
SEED_EQUIPO_PASSWORD="demo-equipo-local"
SEED_OFICINA_EMAIL="oficina@demo.local"
SEED_TECNICO_EMAIL="tecnico@demo.local"
SEED_ENCARGADO_EMAIL="encargado@demo.local"

# --- Opcionales (demo-deployment; ver docs/operacion-demo.md) ---
# URL directa para el CLI de Prisma (migraciones). Si falta, se usa DATABASE_URL.
# DATABASE_URL_UNPOOLED="postgresql://central:central@localhost:5432/central_de_avisos?schema=public"
# Franja «Entorno de demostración · datos ficticios» (solo con el valor exacto
# true; las páginas estáticas la fijan en el build).
# DEMO_MODE="true"
# Ventana del límite de intentos de login, en segundos (60-3600; por defecto 900).
# LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
# Timeout de conexión a PostgreSQL en ms (500-30000; por defecto 2000).
# DATABASE_CONNECTION_TIMEOUT_MS="2000"
# Usuario de cliente del seed de presentación (`npm run demo:seed`, que usa
# .env.demo y no este archivo). La contraseña de ejemplo no vale en la demo.
# SEED_CLIENTE_EMAIL="cliente@demo.local"
# SEED_CLIENTE_PASSWORD="demo-cliente-local"
